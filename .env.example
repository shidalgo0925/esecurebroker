# ESecureBroker — plantilla de entorno
# Prod: /opt/corredores/.env          APP_ENV=prod  puerto 8091
# Dev:  /opt/corredores-dev/.env      APP_ENV=dev   puerto 8092
#
# Bootstrap mínimo en .env; el resto operativo vive en DB → /mantenimiento.

# --- Base de datos (propia — nunca EN1/IIUS) ---
# Prod (Postgres dedicado):
# DATABASE_URL=postgresql+psycopg://corredores_app:CHANGE_ME@127.0.0.1:5432/corredores
# Dev (DB aislada):
# DATABASE_URL=postgresql+psycopg://corredores_app:CHANGE_ME@127.0.0.1:5432/corredores_dev
# Fallback SQLite local:
DATABASE_URL=sqlite:////opt/corredores/var/corredores_p0.db
# CORREDORES_TEST_DATABASE_URL=postgresql+psycopg://corredores_app:CHANGE_ME@127.0.0.1:5432/corredores_test

APP_ENV=dev
LOG_LEVEL=INFO
DOCUMENTS_ROOT=/opt/corredores/var/documents

# URL pública del host (prod vs dev)
# PUBLIC_BASE_URL=https://esecurebroker.etsrv.site
# DEV: un solo nivel bajo etsrv.site (CF Universal SSL). NO usar dev.esecurebroker.etsrv.site
# PUBLIC_BASE_URL=https://esecurebroker-dev.etsrv.site
PUBLIC_BASE_URL=http://127.0.0.1:8091

# Puerta piloto (cookie firmada) — no es identidad EN1 (ADR-006)
AUTH_ENABLED=true
AUTH_USERNAME=broker
AUTH_PASSWORD=CHANGE_ME
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Cookie distinta en cada entorno para no cruzar sesiones
AUTH_COOKIE_NAME=esb_session
# AUTH_COOKIE_NAME=esb_session_dev
AUTH_SESSION_DAYS=14
AUTH_DISPLAY_NAME=Broker ESecureBroker

# --- ADR-006 Ana: UX 100% ESB; EN1 = SoR vía API M2M C1 (nunca UI EN1) ---
# CTAs → /registro. Promo DEV canónica: ESB-DEV-100
# EN1_COMMERCE_ENABLED=true
# EN1_API_BASE_URL=https://appdev.easynodeone.com
# EN1_M2M_TOKEN=   # X-API-Key (secreto; no commitear)

# --- Config operativa (correo, OpenAI, Stripe, dueños, estados auto) ---
# Vive en DB → UI /mantenimiento (tabla system_settings).
# Los valores MAIL_*/OPENAI_*/STRIPE_*/PLATFORM_*/STATEMENT_* del .env solo
# se importan UNA vez si el slot en DB está vacío (migración legacy).
