# Development default: local SQLite (own DB file — not EN1/IIUS).
# Dedicated Postgres (ADR-005): provision with scripts/provision_postgres.sh then:
# DATABASE_URL=postgresql+psycopg://corredores_app:CHANGE_ME@127.0.0.1:5432/corredores
# CORREDORES_TEST_DATABASE_URL=postgresql+psycopg://corredores_app:CHANGE_ME@127.0.0.1:5432/corredores_test
DATABASE_URL=sqlite:////opt/corredores/var/corredores_p0.db
APP_ENV=dev
LOG_LEVEL=INFO

# Correo — estados de cuenta (off by default)
MAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=cobranza@example.com
# SMTP_TLS=true
# SMTP_SSL=false

# Envío automático (CLI send-statements + systemd timer)
STATEMENT_AUTO_ENABLED=false
STATEMENT_AUTO_MIN_DAYS_OVERDUE=1
STATEMENT_AUTO_COOLDOWN_DAYS=7
STATEMENT_AUTO_ONLY_OVERDUE=true

# Puerta piloto (cookie firmada) — no es identidad EN1 (ADR-006)
AUTH_ENABLED=true
AUTH_USERNAME=broker
AUTH_PASSWORD=CHANGE_ME
# Multiempresa piloto (ADR-007): user:pass|user2:pass2  — opcional; si vacío usa AUTH_USERNAME/PASSWORD
# AUTH_USERS=broker-a:pass-a|broker-b:pass-b
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
AUTH_COOKIE_NAME=esb_session
AUTH_SESSION_DAYS=14
AUTH_DISPLAY_NAME=Broker ESecureBroker

# Self-serve / onboarding — identidad y billing definitivos en EN1 (ADR-006)
SAAS_SIGNUP_ENABLED=true
# Si defines URL de EN1, los CTA «Comenzar» de la landing apuntan ahí:
# SAAS_ONBOARDING_URL=https://app.example.com/subscribe
PUBLIC_BASE_URL=https://esecurebroker.etsrv.site
# Stripe solo si el checkout local piloto está activo (sin SAAS_ONBOARDING_URL)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
