[Unit]
Description=ESecureBroker DEV UI (uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=adminnode
Group=adminnode
WorkingDirectory=/opt/corredores-dev
Environment=PYTHONPATH=/opt/corredores-dev
EnvironmentFile=-/opt/corredores-dev/.env
ExecStart=/opt/corredores-dev/.venv/bin/python -m corredores.cli serve --host 127.0.0.1 --port 8092
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
